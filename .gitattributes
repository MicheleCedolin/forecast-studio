# Docker/Linux içinde çalışan dosyalar her platformda LF kalmalıdır (CRLF betikleri bozar).
*.sh   text eol=lf
*.sge  text eol=lf
*.sbatch text eol=lf
*.R    text eol=lf
*.py   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
Dockerfile text eol=lf
*.ps1  text eol=crlf
# Example datasets of the browser page are published byte for byte as in the Monash archive.
web/data/*.tsf -text
